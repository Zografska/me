---
import Base from '../layouts/Base.astro';
import {
  person, profile, aiTech, aiLoop, aiExtras, employer, projects, research,
  leadership, skills, education, languages, other,
} from '../data/cv';
import { torn, tilt } from '../lib/torn';

const ink = (t: string) => (aiTech.has(t) ? 'tag tag--ai' : 'tag');
const nav = [
  ['profile', 'Profile'], ['ai', 'AI workflow'], ['work', 'Work'], ['research', 'Research'],
  ['leadership', 'Leadership'], ['skills', 'Skills'], ['education', 'Education'], ['beyond', 'Beyond code'],
];
const projectNames = Object.fromEntries([
  ...projects.map((p) => [p.id, p.name]),
  [research.id, 'MSc thesis'],
]);
---
<Base
  title={`${person.name.join(' ')}, ${person.title}`}
  description="Lead developer working across Python, TypeScript and C#, building AI-assisted workflows and self-hosted LLM systems. Based in Milan."
>
  <header class="hero" id="top">
    <div class="shape shape--torn ink-pink hero-s1" style={`clip-path:${torn(3, 7, 9)}`} data-depth="0.12" aria-hidden="true"></div>
    <div class="shape shape--torn ink-black hero-s2" style={`clip-path:${torn(5, 9, 11)}`} data-depth="-0.08" aria-hidden="true"></div>
    <div class="shape shape--torn ink-pink hero-s3" style={`clip-path:${torn(8, 14, 7)}`} data-depth="0.2" aria-hidden="true"></div>
    <div class="shape shape--torn dots hero-s4" style={`clip-path:${torn(21, 10, 8)}`} data-depth="-0.14" aria-hidden="true"></div>
    <span class="tape hero-tape hero-tape--a" aria-hidden="true"></span>
    <span class="tape hero-tape hero-tape--b" aria-hidden="true"></span>
    <span class="tape hero-tape hero-tape--c" aria-hidden="true"></span>
    <svg class="scrawl hero-scrawl" viewBox="0 0 200 120" aria-hidden="true"><path pathLength="1" d="M18 70C30 20 90 8 120 30s-10 70-50 60S20 40 70 22s110 0 100 40-80 50-110 30S40 30 95 40s60 30 40 50" /></svg>
    <svg class="scrawl hero-star" viewBox="0 0 100 100" aria-hidden="true"><path pathLength="1" d="M50 6L58 42 94 34 64 56 84 90 50 68 18 92 34 56 6 36 42 42Z" /></svg>
    <svg class="scrawl hero-x" viewBox="0 0 60 60" aria-hidden="true"><path pathLength="1" d="M8 10C22 22 40 40 52 54M50 8C36 24 22 38 10 52" /></svg>
    <svg class="reg hero-reg hero-reg--a" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="9" /><path d="M20 2v36M2 20h36" /></svg>
    <svg class="reg hero-reg hero-reg--b" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="9" /><path d="M20 2v36M2 20h36" /></svg>

    <p class="raw" aria-hidden="true">
      <span class="mk mk-circle" style="--d:.55s">Generalist<svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none"><path pathLength="1" d="M10 23C9 8 86 3 94 17c6 14-55 22-82 13C1 26 6 11 26 7" /></svg></span>
      software engineer with <span class="mk mk-hl mk-hl--pink" style="--d:.75s">5+ years</span> of experience shipping web, mobile, backend and LLM-powered products across
      <span class="mk mk-hl" style="--d:.95s">Python, TypeScript and C#</span>. From
      <span class="mk mk-strike" style="--d:1.15s">sole developer</span> on a frontend migration to
      <span class="mk mk-circle" style="--d:1.3s">Tech&nbsp;Lead<svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none"><path pathLength="1" d="M8 21C11 6 90 4 95 19c3 13-60 20-84 11C0 26 7 12 30 6" /></svg></span>
      owning architecture and delivery. I design the
      <span class="mk mk-hl mk-hl--pink" style="--d:1.5s">Claude Code workflows</span> my team develops with, keeping a
      <span class="mk mk-under" style="--d:1.65s">human in the loop<svg class="squiggle" viewBox="0 0 100 10" preserveAspectRatio="none"><path pathLength="1" d="M1 6c8-5 12 4 20 0s12-5 20 0 12 4 20 0 12-5 20 0 12 4 18-1" /></svg></span>
      at every step, and build LLM systems on self-hosted models where data privacy rules out
      <span class="mk mk-strike" style="--d:1.8s">third-party APIs</span>.
    </p>

    <h1 class="name">
      <span class="name-ink name-ink--base">
        <span>{person.name[0]}</span><span>{person.name[1]}</span>
      </span>
      <span class="name-ink name-ink--over" aria-hidden="true">
        <span>{person.name[0]}</span><span>{person.name[1]}</span>
      </span>
    </h1>

    <div class="scrap-wrap hero-card" style={`--tilt:-2deg;--under-a:${torn(31, 2.5)};--under-b:${torn(37, 3)}`}>
      <span class="tape tape--tl" aria-hidden="true"></span>
      <span class="tape tape--br" aria-hidden="true"></span>
      <div class="scrap" style={`clip-path:${torn(11)}`}>
        <p class="hero-title">{person.title}</p>
        <p class="hero-sub">{person.subtitle}</p>
        <p class="hero-place">Based in {person.location}</p>
        <ul class="tags" aria-label="Core stack">
          {person.coreStack.map((t) => <li class={ink(t)}>{t}</li>)}
        </ul>
        <ul class="links">
          <li><a href={`mailto:${person.email}`}>Email me</a></li>
          <li><a href={person.github} rel="me">GitHub</a></li>
          <li><a href={`${import.meta.env.BASE_URL}${person.cv}`} download>Download CV (PDF)</a></li>
        </ul>
      </div>
    </div>
  </header>

  <nav class="nav" aria-label="Sections">
    <ul>
      {nav.map(([id, label]) => <li><a href={`#${id}`} data-nav={id}>{label}</a></li>)}
    </ul>
  </nav>

  <main>
    <section id="profile" class="sec">
      <div class="shape shape--slab ink-black prof-s1" data-depth="0.1" aria-hidden="true"></div>
      <h2 class="h" style="--tilt:-1.5deg">Profile</h2>
      <div class="core">
        <p class="lede">{profile}</p>
      </div>
    </section>

    <section id="ai" class="sec">
      <div class="shape shape--disc ink-pink ai-s1" data-depth="-0.1" aria-hidden="true"></div>
      <h2 class="h" style="--tilt:1.2deg">How I work with AI</h2>
      <div class="core">
        <p>Claude Code runs across the full development lifecycle: planning, scaffolding, refactoring, tests, review, debugging and docs. This is the loop I built for the Game Center team.</p>
      </div>
      <ol class="loop">
        {aiLoop.map((s, i) => (
          <li class="scrap-wrap loop-step" style={`--tilt:${tilt(i + 3, 2.2)}deg`}>
            <span class="tape tape--top" aria-hidden="true"></span>
            <div class="scrap" style={`clip-path:${torn(40 + i, 1.4)}`}>
              <span class="loop-n" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="loop-back core">Then back to step one for the next task.</p>
      <div class="extras core">
        {aiExtras.map((e) => (
          <div class="extra">
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="work" class="sec">
      <div class="shape shape--wedge ink-black work-s1" data-depth="0.14" aria-hidden="true"></div>
      <h2 class="h" style="--tilt:-1deg">Work</h2>
      <div class="role-head core">
        <h3>{employer.title}, {employer.company}</h3>
        <p class="meta"><span>{employer.dates}</span><span>{employer.place}</span></p>
      </div>
      <ol class="timeline">
        {projects.map((p, i) => (
          <li class="tl-item">
            <details class="project" id={p.id} data-skills={p.skills.join('|')}>
              <summary>
                <span class="tape tape--peel" aria-hidden="true" style={`--tilt:${tilt(i + 20, 6)}deg`}></span>
                {p.selfHosted && <span class="stamp" aria-hidden="true">Self-hosted</span>}
                <h3 class="p-name">{p.name}</h3>
                <p class="p-role">{p.role}</p>
                {p.migration && (
                  <p class="migration">
                    <s>{p.migration.from}</s> <span class="mig-arrow">rebuilt as</span> <strong>{p.migration.to}</strong>
                  </p>
                )}
                <p class="p-summary">{p.summary}</p>
                <ul class="tags" aria-label="Stack">{p.stack.map((t) => <li class={ink(t)}>{t}</li>)}</ul>
                <span class="toggle"><span class="t-open">Read the details</span><span class="t-close">Close</span></span>
              </summary>
              <ul class="p-bullets">{p.bullets.map((b) => <li>{b}</li>)}</ul>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section id="research" class="sec">
      <div class="shape shape--disc ink-black res-s1" data-depth="0.12" aria-hidden="true"></div>
      <div class="shape shape--slab ink-pink res-s2" data-depth="-0.06" aria-hidden="true"></div>
      <h2 class="h" style="--tilt:1.6deg">Research</h2>
      <div class="core research-head" id={research.id} data-skills={research.skills.join('|')}>
        <span class="stamp stamp--static" aria-hidden="true">Self-hosted</span>
        <p class="meta"><span>{research.kind}</span><span>{research.status}</span></p>
        <h3 class="thesis-title">{research.title}</h3>
      </div>
      <ol class="pipeline" aria-label="Thesis pipeline">
        {research.pipeline.map((s, i) => (
          <li class="pipe-step" style={`--tilt:${tilt(i + 60, 1.8)}deg`}>
            <div class="scrap" style={`clip-path:${torn(70 + i, 2)}`}>
              <h4>{s.step}</h4>
              <p>{s.text}</p>
            </div>
            {i < research.pipeline.length - 1 && (
              <svg class="pipe-arrow" viewBox="0 0 60 30" aria-hidden="true"><path d="M2 17c14-6 28 3 46-2M40 7l10 8-11 7" /></svg>
            )}
          </li>
        ))}
      </ol>
      <div class="core">
        <ul class="bullets">{research.bullets.map((b) => <li>{b}</li>)}</ul>
        <ul class="tags" aria-label="Stack">{research.stack.map((t) => <li class={ink(t)}>{t}</li>)}</ul>
      </div>
    </section>

    <section id="leadership" class="sec sec--quiet">
      <h2 class="h" style="--tilt:-2deg">Leadership</h2>
      <div class="core">
        <h3>{leadership.title}, {leadership.company}</h3>
        <p class="meta"><span>{leadership.dates}</span></p>
        <ul class="bullets">{leadership.bullets.map((b) => <li>{b}</li>)}</ul>
      </div>
    </section>

    <section id="skills" class="sec">
      <div class="shape shape--wedge ink-pink sk-s1" data-depth="0.1" aria-hidden="true"></div>
      <h2 class="h" style="--tilt:1deg">Skills</h2>
      <div class="core">
        <p>Pick a sticker to see where I used it. Pink is AI and LLM work, black is everything else.</p>
        <p class="sk-result" aria-live="polite" id="sk-result"></p>
      </div>
      <div class="sheet">
        {skills.map((g, gi) => (
          <div class="sheet-group">
            <h3>{g.area}</h3>
            <ul>
              {g.items.map((s, i) => (
                <li>
                  <button type="button" class={aiTech.has(s) ? 'sticker sticker--ai' : 'sticker'} data-skill={s} aria-pressed="false" style={`--tilt:${tilt(gi * 31 + i, 3.5)}deg`}>{s}</button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="education" class="sec sec--quiet sec--wall">
      <p class="graffiti" aria-hidden="true">We don't need no</p>
      <h2 class="h" style="--tilt:-1.2deg">Education</h2>
      <div class="scrap-wrap flyer" style="--tilt:-0.6deg">
        <span class="tape tape--tl" aria-hidden="true"></span>
        <span class="tape tape--br" aria-hidden="true"></span>
        <div class="scrap" style={`clip-path:${torn(77, 1.2)}`}>
          <div class="core two-col">
            <div>
              {education.map((e) => (
                <div class="edu">
                  <h3>{e.degree}</h3>
                  <p>{e.school}</p>
                  <p class="meta"><span>{e.dates}</span><span>{e.place}</span></p>
                </div>
              ))}
            </div>
            <div>
              <h3 class="lang-h">Languages</h3>
              <div class="langs-wrap">
                <dl class="langs">
                  {languages.map((l) => (<><dt>{l.name}</dt><dd>{l.level}</dd></>))}
                </dl>
                <svg class="langs-grid" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M-2.5 2.2C22-.8 58 3.4 102.5.2M98.6-4C101.4 28 98 66 100.9 103.5M-3 98.2C28 101.8 64 97.4 101.8 100.6M1.4-3C-1.2 31 2.4 68-.2 102.8" />
                  <path class="langs-grid-in" d={`M37.4-3C40 28 36.2 66 39.2 103${languages.slice(1).map((_, i) => {
                    const y = ((i + 1) * 100) / languages.length, w = i % 2 ? -1 : 1;
                    return `M-1.5 ${y + 1.2 * w}C26 ${y - 2.2 * w} 62 ${y + 2.4 * w} 101.5 ${y - 1.1 * w}`;
                  }).join('')}`} />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="beyond" class="sec">
      <h2 class="h" style="--tilt:2deg">Beyond code</h2>
      <ul class="beyond">
        {other.map((o, i) => (
          <li class="scrap-wrap" style={`--tilt:${tilt(i + 90, 2.6)}deg`}>
            <span class="tape tape--top" aria-hidden="true"></span>
            <div class="scrap" style={`clip-path:${torn(100 + i, 1.6)}`}>
              <h3>{o.title}</h3>
              <p class="meta"><span>{o.where}</span><span>{o.when}</span></p>
              {o.text && <p>{o.text}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-core">
      <p>Get in touch.</p>
      <ul class="links">
        <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
        <li><a href={person.github} rel="me">github.com/{person.githubHandle}</a></li>
        <li><a href={`${import.meta.env.BASE_URL}${person.cv}`} download>Download CV (PDF)</a></li>
      </ul>
    </div>
    <p class="foot-name" aria-hidden="true">
      <span class="fn-base">{person.name[0]}</span><span class="fn-over">{person.name[0]}</span>
    </p>
  </footer>

  <script define:vars={{ projectNames }}>
    // Skill stickers: light up the projects that used a skill.
    const result = document.getElementById('sk-result');
    const cards = [...document.querySelectorAll('[data-skills]')];
    let active = null;
    document.querySelectorAll('.sticker').forEach((btn) => {
      btn.addEventListener('click', () => {
        const skill = btn.dataset.skill;
        const same = active === btn;
        document.querySelectorAll('.sticker[aria-pressed="true"]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        cards.forEach((c) => c.classList.remove('is-lit'));
        result.textContent = '';
        if (same) { active = null; return; }
        active = btn;
        btn.setAttribute('aria-pressed', 'true');
        const hits = cards.filter((c) => c.dataset.skills.split('|').includes(skill));
        hits.forEach((c) => c.classList.add('is-lit'));
        if (!hits.length) {
          result.textContent = `${skill}: on my CV, but not part of a featured project here. Ask me about it.`;
          return;
        }
        result.append(`${skill} shows up in `);
        hits.forEach((c, i) => {
          const a = document.createElement('a');
          a.href = `#${c.id}`;
          a.textContent = projectNames[c.id];
          result.append(a, i < hits.length - 2 ? ', ' : i === hits.length - 2 ? ' and ' : '.');
        });
      });
    });

    // Section tracking for the nav.
    const links = new Map([...document.querySelectorAll('[data-nav]')].map((a) => [a.dataset.nav, a]));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
    // At the very bottom the last section can't reach the middle band, so mark it directly.
    addEventListener('scroll', () => {
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) {
        links.forEach((a) => a.removeAttribute('aria-current'));
        [...links.values()].at(-1).setAttribute('aria-current', 'true');
      }
    }, { passive: true });

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Stamps: click to stamp again, at a new angle, with a thud.
    document.querySelectorAll('.stamp').forEach((st) => {
      st.addEventListener('click', (e) => {
        e.preventDefault(); // stamps inside <summary> must not toggle the project
        e.stopPropagation();
        st.style.setProperty('--stamp-rot', `${(-15 + Math.random() * 12).toFixed(1)}deg`);
        if (reduce) return;
        st.animate(
          [{ scale: 1.7, opacity: 0 }, { scale: 0.88, opacity: 1, offset: 0.55 }, { scale: 1.04 }, { scale: 1 }],
          { duration: 380, easing: 'cubic-bezier(.2,.8,.2,1)' },
        );
        (st.closest('.project') || st.parentElement).animate(
          [{ translate: '0 0' }, { translate: '0 3px' }, { translate: '0 0' }],
          { duration: 160, delay: 190 },
        );
      });
    });

    // Hero pile: drag the scraps around. Fling one hard and it cracks the copier glass.
    const hero = document.querySelector('.hero');
    const canDrag = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 821px)');
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const cracks = [];
    const crack = (x, y) => {
      const r = hero.getBoundingClientRect();
      const C = 240, rnd = (a, b) => a + Math.random() * (b - a);
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'crack');
      svg.setAttribute('viewBox', `0 0 ${C * 2} ${C * 2}`);
      svg.setAttribute('aria-hidden', 'true');
      svg.style.left = `${x - r.left}px`;
      svg.style.top = `${y - r.top}px`;
      // A crack wanders: short straight runs with small kinks, now and then a sharp one.
      const walk = (x0, y0, a, len) => {
        const pts = [[x0, y0]];
        let px = x0, py = y0, done = 0;
        while (done < len) {
          const step = rnd(5, 16);
          a += Math.random() < 0.15 ? rnd(-0.6, 0.6) : rnd(-0.18, 0.18);
          px += Math.cos(a) * step; py += Math.sin(a) * step; done += step;
          pts.push([px, py]);
        }
        return pts;
      };
      const d = (pts) => 'M' + pts.map(([a, b]) => `${a.toFixed(1)} ${b.toFixed(1)}`).join('L');
      const lines = []; // [points, class, delay]
      // Main cracks at uneven angles, a few long and a few short.
      const angles = [];
      const n = Math.floor(rnd(4, 7));
      while (angles.length < n) {
        const a = rnd(0, Math.PI * 2);
        if (angles.every((b) => Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b))) > 0.45)) angles.push(a);
      }
      angles.forEach((a, i) => {
        const pts = walk(C, C, a, i < 2 ? rnd(150, 225) : rnd(45, 130));
        lines.push([pts, 'crack-main', 0]);
        // Forks split off partway along and run outward.
        const forks = Math.random() < 0.7 ? Math.floor(rnd(1, 3)) : 0;
        for (let f = 0; f < forks; f++) {
          const at = pts[Math.floor(rnd(0.3, 0.8) * pts.length)];
          lines.push([walk(at[0], at[1], a + (Math.random() < 0.5 ? -1 : 1) * rnd(0.35, 0.9), rnd(25, 80)), 'crack-fork', 0.1]);
        }
      });
      // One partial ring near the impact, at most.
      if (Math.random() < 0.5) {
        const a0 = rnd(0, Math.PI * 2), rr = rnd(16, 34), pts = [];
        for (let t = 0; t <= 1; t += 0.2) pts.push([C + Math.cos(a0 + t * 1.4) * rr * rnd(0.9, 1.1), C + Math.sin(a0 + t * 1.4) * rr * rnd(0.9, 1.1)]);
        lines.push([pts, 'crack-fork', 0.15]);
      }
      // Crushed glass right at the impact.
      let out = '';
      for (let k = 0; k < 14; k++) {
        const a = rnd(0, Math.PI * 2), r0 = rnd(0, 4), r1 = r0 + rnd(3, 11);
        out += `<path class="crack-chip" pathLength="1" d="M${(C + Math.cos(a) * r0).toFixed(1)} ${(C + Math.sin(a) * r0).toFixed(1)}L${(C + Math.cos(a) * r1).toFixed(1)} ${(C + Math.sin(a) * r1).toFixed(1)}" />`;
      }
      // Each crack gets a pale glint beside it, the way a fractured edge catches light.
      lines.forEach(([pts, cls, delay]) => {
        const path = d(pts);
        out += `<path class="crack-glint" pathLength="1" d="${path}" style="animation-delay:${delay}s" />`;
        out += `<path class="${cls}" pathLength="1" d="${path}" style="animation-delay:${delay}s" />`;
      });
      svg.innerHTML = out;
      hero.append(svg);
      cracks.push(svg);
      if (cracks.length > 3) cracks.shift().remove();
      setTimeout(() => svg.classList.add('is-fading'), 5000);
      setTimeout(() => { svg.remove(); cracks.splice(cracks.indexOf(svg), 1); }, 6400);
    };
    hero.querySelectorAll('.shape, .hero-tape, .scrawl').forEach((el) => {
      el.addEventListener('pointerdown', (e) => {
        if (!canDrag.matches || e.button !== 0) return;
        e.preventDefault();
        el.setPointerCapture(e.pointerId);
        const sx = e.clientX, sy = e.clientY;
        const bx = parseFloat(el.style.getPropertyValue('--dx')) || 0;
        const by = parseFloat(el.style.getPropertyValue('--dy')) || 0;
        let moved = false;
        const trail = [{ x: sx, y: sy, t: e.timeStamp }];
        el.classList.add('is-held');
        const move = (ev) => {
          const r = hero.getBoundingClientRect();
          const x = clamp(ev.clientX, r.left, r.right), y = clamp(ev.clientY, r.top, r.bottom);
          if (Math.abs(x - sx) + Math.abs(y - sy) > 4) moved = true;
          el.style.setProperty('--dx', `${bx + x - sx}px`);
          el.style.setProperty('--dy', `${by + y - sy}px`);
          trail.push({ x, y, t: ev.timeStamp });
          while (trail.length > 2 && ev.timeStamp - trail[0].t > 80) trail.shift();
        };
        const up = (ev) => {
          el.removeEventListener('pointermove', move);
          el.removeEventListener('pointerup', up);
          el.removeEventListener('pointercancel', up);
          el.classList.remove('is-held');
          if (!moved) return;
          const a = trail[0], b = trail.at(-1);
          const speed = Math.hypot(b.x - a.x, b.y - a.y) / Math.max(1, b.t - a.t);
          if (speed > 1.2) crack(b.x, b.y);
          if (!reduce) el.animate({ scale: [1.07, 1] }, { duration: 200, easing: 'cubic-bezier(.3,1.6,.5,1)' });
        };
        el.addEventListener('pointermove', move);
        el.addEventListener('pointerup', up);
        el.addEventListener('pointercancel', up);
      });
    });

    // Footer: the name runs through the press once, when it comes into view.
    const footName = document.querySelector('.foot-name');
    if (!reduce && footName && 'IntersectionObserver' in window) {
      footName.classList.add('foot-name--wait');
      const fo = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        footName.classList.remove('foot-name--wait');
        footName.classList.add('is-printed');
        fo.disconnect();
      }, { threshold: 0.6 });
      fo.observe(footName);
    }

    // Slow parallax on the background shapes. Off when reduced motion is requested.
    if (!reduce) {
      const shapes = [...document.querySelectorAll('[data-depth]')];
      let ticking = false;
      const update = () => {
        const vh = innerHeight;
        shapes.forEach((s) => {
          const r = s.parentElement.getBoundingClientRect();
          const raw = (r.top + r.height / 2 - vh / 2) * parseFloat(s.dataset.depth);
          const off = Math.max(-60, Math.min(60, raw));
          s.style.setProperty('--py', `${off.toFixed(1)}px`);
        });
        ticking = false;
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
  </script>
</Base>
